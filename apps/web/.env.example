# Copy to .env.local and fill in real values. Never commit real keys here:
# this file is tracked by git, unlike .env.local.
#
# The app treats any value containing "your-" as unset, so an unfilled copy
# degrades gracefully instead of half-working.

# Supabase project URL and public anon key. Both are safe to expose in the
# browser: the anon key is restricted by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Browser key for Places autocomplete and the static route map. Restrict it by
# HTTP referrer in the Google Cloud console, since it ships to the client.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Canonical origin, used for metadata, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# SERVER ONLY. Bypasses row level security entirely, so it must never be
# prefixed with NEXT_PUBLIC_ or pasted anywhere the browser can read.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
