# Local secrets for `supabase functions serve`. Copy to .env (git-ignored).
# On the live project the same names are set with `supabase secrets set`.

# Must match the notify_booking_secret Vault entry (supabase/seed.sql sets
# "local-webhook-secret" for the local database).
WEBHOOK_SECRET=local-webhook-secret

# From resend.com → API Keys. Leave empty to only log emails.
RESEND_API_KEY=

# Resend's test sender works without a verified domain, but only delivers to
# the address the Resend account was created with. Send everything there.
EMAIL_FROM=Taxi Teià <onboarding@resend.dev>
EMAIL_OVERRIDE_TO=you@example.com
